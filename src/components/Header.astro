---
import { SITE_TITLE, NAV_ITEMS } from '../consts';
// Determine if the current page is active
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="nav-links">
			{
				NAV_ITEMS.map((item) => {
					const itemPath = item.href.replace(/\/$/, '') || '/';
					const isActive = currentPath === itemPath || 
						(itemPath !== '/' && currentPath.startsWith(itemPath));
					return (
						<a href={item.href} class:list={['nav-item', { active: isActive }]}>
							{item.label}
						</a>
					);
				})
			}
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a {
		text-decoration: none;
		color: var(--black);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.nav-links {
		display: flex;
		gap: 0.25em;
	}
	.nav-item {
		padding: 1em 0.75em;
		color: var(--black);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.95em;
		transition: border-color 0.2s;
	}
	.nav-item:hover {
		border-bottom-color: rgba(var(--accent), 0.3);
	}
	.nav-item.active {
		border-bottom-color: var(--accent);
		font-weight: 700;
	}

	@media (max-width: 720px) {
		header {
			padding: 0 0.5em;
		}
		nav {
			flex-wrap: wrap;
			justify-content: center;
			gap: 0 0.5em;
			padding: 0.5em 0;
		}
		nav h2 {
			flex: 1 1 100%;
			text-align: center;
			font-size: 1.05em;
			padding-bottom: 0.25em;
		}
		.nav-links {
			width: 100%;
			justify-content: center;
			gap: 0.25em;
		}
		.nav-item {
			padding: 0.6em 0.9em;
			font-size: 0.95em;
			border-bottom: 2px solid transparent;
		}
	}
</style>
