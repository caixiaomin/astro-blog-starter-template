---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	/** Hide header/footer for standalone pages (e.g. short-demo) */
	hideChrome?: boolean;
}

const { title, description, image, hideChrome = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
		</style>
	</head>
	<body>
		{!hideChrome && <Header />}
		<main>
			<slot />
		</main>
		{!hideChrome && <Footer />}
	</body>
</html>
