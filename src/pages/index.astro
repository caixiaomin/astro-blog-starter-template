---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>

	<!-- ==========================================
	🎯 Section 1: Hero
	========================================== -->
	<section class="hero">
		<h1 class="hero-title">
			<!-- 👇 Replace with your product name -->
			Your Product Name
		</h1>
		<p class="hero-subtitle">
			<!-- 👇 Replace with your one-line value proposition -->
			Summarize your product's core value in one sentence so users instantly know what it does.
		</p>
		<div class="hero-actions">
			<a href="/guide/" class="btn btn-primary">View Guide</a>
			<a href="/about/" class="btn btn-outline">Learn More</a>
		</div>
	</section>

	<!-- ==========================================
	⭐ Section 2: Key Features
	========================================== -->
	<section class="features">
		<h2>Key Features</h2>
		<div class="feature-grid">
			<!-- 👇 Feature 1: copy the entire .feature-card block to add more -->
			<div class="feature-card">
				<div class="feature-icon">🚀</div>
				<h3>Feature 1 Title</h3>
				<p>Describe the benefit of this feature — what problem it solves and what value it brings.</p>
			</div>
			<!-- Feature 2 -->
			<div class="feature-card">
				<div class="feature-icon">⚡</div>
				<h3>Feature 2 Title</h3>
				<p>Describe the benefit of this feature.</p>
			</div>
			<!-- Feature 3 -->
			<div class="feature-card">
				<div class="feature-icon">🎨</div>
				<h3>Feature 3 Title</h3>
				<p>Describe the benefit of this feature.</p>
			</div>
			<!-- Feature 4 -->
			<div class="feature-card">
				<div class="feature-icon">🔒</div>
				<h3>Feature 4 Title</h3>
				<p>Describe the benefit of this feature.</p>
			</div>
		</div>
	</section>

	<!-- ==========================================
	📱 Section 3: Use Cases
	========================================== -->
	<section class="scenarios">
		<h2>Use Cases</h2>
		<div class="scenario-list">
			<!-- 👇 Scenario 1: copy scenario-item to add more -->
			<div class="scenario-item">
				<div class="scenario-text">
					<h3>Scenario 1 Name</h3>
					<p>Describe how users use your product in this scenario and what real-world problem it solves. Include a concrete example if possible.</p>
				</div>
				<div class="scenario-image">
					<!-- 👇 Replace with your screenshot path, place the file in public/ -->
					<img src="/blog-placeholder-1.jpg" alt="Scenario 1 screenshot" />
					<span class="image-hint">▲ Replace with product screenshot</span>
				</div>
			</div>
			<!-- Scenario 2 -->
			<div class="scenario-item scenario-reverse">
				<div class="scenario-text">
					<h3>Scenario 2 Name</h3>
					<p>Describe the usage in this scenario.</p>
				</div>
				<div class="scenario-image">
					<img src="/blog-placeholder-2.jpg" alt="Scenario 2 screenshot" />
					<span class="image-hint">▲ Replace with product screenshot</span>
				</div>
			</div>
			<!-- Scenario 3 -->
			<div class="scenario-item">
				<div class="scenario-text">
					<h3>Scenario 3 Name</h3>
					<p>Describe the usage in this scenario.</p>
				</div>
				<div class="scenario-image">
					<img src="/blog-placeholder-3.jpg" alt="Scenario 3 screenshot" />
					<span class="image-hint">▲ Replace with product screenshot</span>
				</div>
			</div>
		</div>
	</section>

	<!-- ==========================================
	🎬 Section 4: Product Demo / Video
	========================================== -->
	<section class="demo">
		<h2>Product Demo</h2>
		<div class="video-wrapper">
			<!-- 👇 Replace src with your video embed link (YouTube / Bilibili embed URL) -->
			<iframe
				class="demo-video"
				src="https://www.youtube.com/embed/dQw4w9WgXcQ"
				title="Product demo video"
				frameborder="0"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
				allowfullscreen
			>
			</iframe>
			<!-- Or replace with a local screenshot carousel -->
		</div>
		<p class="video-hint">
			👆 Replace the video link above with your product demo (YouTube/Bilibili embed link)
		</p>
	</section>

	<!-- ==========================================
	📞 Section 5: Call to Action
	========================================== -->
	<section class="cta">
		<h2>Ready to Get Started?</h2>
		<p>Check out the user guide to learn how to get up and running quickly.</p>
		<a href="/guide/" class="btn btn-primary">View Guide →</a>
	</section>

</BaseLayout>

<style>
	/* === Hero === */
	.hero {
		text-align: center;
		padding: 4em 0 3em;
	}
	.hero-title {
		font-size: 3rem;
		margin-bottom: 0.3em;
		background: linear-gradient(135deg, var(--accent), #c026d3);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	.hero-subtitle {
		font-size: 1.25rem;
		color: rgb(var(--gray));
		max-width: 600px;
		margin: 0 auto 1.5em;
		line-height: 1.6;
	}
	.hero-actions {
		display: flex;
		gap: 1em;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* === Buttons === */
	.btn {
		display: inline-block;
		padding: 0.75em 1.75em;
		border-radius: 8px;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s;
		font-size: 1rem;
	}
	.btn-primary {
		background: var(--accent);
		color: white;
	}
	.btn-primary:hover {
		background: var(--accent-dark);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(var(--accent), 0.4);
	}
	.btn-outline {
		border: 2px solid var(--accent);
		color: var(--accent);
	}
	.btn-outline:hover {
		background: var(--accent);
		color: white;
	}

	/* === Section Titles === */
	h2 {
		text-align: center;
		margin-bottom: 1.5em;
		position: relative;
	}
	h2::after {
		content: '';
		display: block;
		width: 60px;
		height: 3px;
		background: var(--accent);
		margin: 0.5em auto 0;
		border-radius: 2px;
	}

	/* === Features === */
	.features {
		padding: 3em 0;
	}
	.feature-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5em;
	}
	.feature-card {
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		padding: 1.5em;
		text-align: center;
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.feature-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--box-shadow);
	}
	.feature-icon {
		font-size: 2.5rem;
		margin-bottom: 0.5em;
	}
	.feature-card h3 {
		font-size: 1.1rem;
		margin-bottom: 0.5em;
	}
	.feature-card p {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		line-height: 1.6;
	}

	/* === Scenarios === */
	.scenarios {
		padding: 3em 0;
	}
	.scenario-list {
		display: flex;
		flex-direction: column;
		gap: 3em;
	}
	.scenario-item {
		display: flex;
		align-items: center;
		gap: 3em;
	}
	.scenario-reverse {
		flex-direction: row-reverse;
	}
	.scenario-text {
		flex: 1;
		min-width: 0;
	}
	.scenario-text h3 {
		margin-bottom: 0.5em;
	}
	.scenario-text p {
		color: rgb(var(--gray));
		line-height: 1.7;
	}
	.scenario-image {
		flex: 1;
		min-width: 0;
	}
	.scenario-image img {
		width: 100%;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.image-hint {
		display: block;
		text-align: center;
		font-size: 0.75rem;
		color: rgb(var(--gray));
		margin-top: 0.5em;
	}

	/* === Demo Video === */
	.demo {
		padding: 3em 0;
	}
	.video-wrapper {
		position: relative;
		padding-bottom: 56.25%; /* 16:9 */
		height: 0;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: var(--box-shadow);
	}
	.demo-video {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border-radius: 12px;
	}
	.video-hint {
		text-align: center;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		margin-top: 1em;
	}

	/* === CTA === */
	.cta {
		text-align: center;
		padding: 3em 0;
		background: linear-gradient(135deg, rgba(var(--accent), 0.05), rgba(var(--accent), 0.1));
		border-radius: 16px;
		margin: 2em 0;
	}
	.cta h2 {
		margin-bottom: 0.3em;
	}
	.cta p {
		color: rgb(var(--gray));
		margin-bottom: 1.5em;
	}

	/* === Responsive === */
	@media (max-width: 768px) {
		.hero-title {
			font-size: 2rem;
		}
		.scenario-item,
		.scenario-reverse {
			flex-direction: column;
			gap: 1.5em;
		}
		.feature-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
