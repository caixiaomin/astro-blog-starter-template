---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us" description="About the product and team">

	<h1>About Us</h1>

	<!-- ==========================================
	ℹ️ Product Overview
	========================================== -->
	<!-- ==========================================
		<section>
			<h2>Product Overview</h2>
			<p>
				<!-- 👇 Fill in: your product introduction, 1-2 paragraphs -->
				Introduce your product here: what it is, why it was created, and what pain points it solves.
			</p>
			<p>
				You can add a second paragraph about the product's journey or vision.
			</p>
		</section>
	========================================== -->

	<!-- ==========================================
	👥 Team / Company Info
	========================================== -->
	<section>
		<h2>Team</h2>
		<p>
			<!-- 👇 Fill in: team/company introduction -->
			We are a dedicated team of professionals committed to delivering high-quality products and services.
		</p>
	</section>

	<!-- ==========================================
	📧 Contact
	========================================== -->
	<section>
		<h2>Contact</h2>
		<ul class="contact-list">
			<li>📧 Email: <a href="mailto:your@email.com">yanchx@hotmail.com</a></li>
			<!-- 👇 Add more contact methods -->
		</ul>
	</section>

	<!-- ==========================================
	🔏 Privacy Policy Entry
	========================================== -->
	<section class="privacy-entry">
		<h2>Legal</h2>
		<p>View our <a href="/about/privacy/">Privacy Policy</a>.</p>
	</section>

</BaseLayout>

<style>
	section {
		margin-bottom: 2.5em;
	}
	section h2 {
		text-align: left;
		margin-bottom: 0.5em;
	}
	section h2::after {
		margin: 0.3em 0 0 0;
	}
	p {
		color: rgb(var(--gray-dark));
		line-height: 1.8;
		max-width: 700px;
	}
	.contact-list {
		list-style: none;
		padding: 0;
		line-height: 2;
	}
	.contact-list a {
		text-decoration: none;
	}
	.contact-list a:hover {
		text-decoration: underline;
	}
	.privacy-entry {
		background: rgba(var(--gray-light), 0.4);
		padding: 1.5em;
		border-radius: 12px;
	}
	.privacy-entry h2 {
		margin-top: 0;
	}
</style>
