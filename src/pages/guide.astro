---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="User Guide - Smart Photos Backup" description="Detailed usage instructions for all product features">

	<!-- ==========================================
	✅ Page Title
	========================================== -->
	<h1>User Guide</h1>
	<p class="guide-intro">
		Welcome to the user guide. The following sections walk through each feature's usage and best practices.
		If you need help, please contact our support team.
	</p>

	<!-- ==========================================
	📖 Table of Contents (quick navigation)
	========================================== -->
	<nav class="toc">
		<h3>Table of Contents</h3>
		<ol>
			<!-- 👇 Keep these in sync with the feature sections below -->
			<li><a href="#feature-1">Feature 1: Feature Name</a></li>
			<li><a href="#feature-2">Feature 2: Feature Name</a></li>
			<li><a href="#feature-3">Feature 3: Feature Name</a></li>
			<li><a href="#feature-4">Feature 4: Feature Name</a></li>
		</ol>
	</nav>

	<hr />

	<!-- ==========================================
	🔧 Feature 1
	========================================== -->
	<section id="feature-1" class="guide-section">
		<h2>Feature 1: Feature Name</h2>

		<!-- Overview -->
		<div class="subsection">
			<h3>Overview</h3>
			<p>
				<!-- 👇 Fill in: briefly describe what this feature does -->
				Briefly explain what this feature does and when to use it.
			</p>
		</div>

		<!-- Steps -->
		<div class="subsection">
			<h3>How to Use</h3>
			<ol class="steps">
				<li>
					<strong>Step 1 Name:</strong>
					<!-- 👇 Fill in: detailed step description -->
					Describe what to do in this step, e.g., open the app and click the menu button in the top-left corner.
				</li>
				<li>
					<strong>Step 2 Name:</strong>
					Describe what to do in this step.
				</li>
				<li>
					<strong>Step 3 Name:</strong>
					Describe what to do in this step.
				</li>
			</ol>
		</div>

		<!-- Screenshot -->
		<div class="subsection">
			<h3>Screenshot</h3>
			<div class="screenshot">
				<!-- 👇 Replace with your screenshot -->
				<img src="/blog-placeholder-1.jpg" alt="Feature 1 screenshot" />
				<p class="caption">▲ Feature 1 interface (replace with actual screenshot)</p>
			</div>
		</div>

		<!-- Tips -->
		<div class="subsection">
			<h3>Tips</h3>
			<ul>
				<li>Usage tips or things to keep in mind.</li>
				<li>Common mistakes and how to avoid them.</li>
			</ul>
		</div>

		<a href="#" class="back-to-top">↑ Back to top</a>
	</section>

	<hr />

