<style>
	.guide-intro {
		font-size: 1.1rem;
		color: rgb(var(--gray));
		line-height: 1.6;
		margin-bottom: 2em;
	}

	/* === Table of Contents === */
	.toc {
		background: rgba(var(--gray-light), 0.4);
		border-radius: 12px;
		padding: 1.25em 1.5em;
		margin-bottom: 2em;
	}
	.toc h3 {
		margin-bottom: 0.5em;
	}
	.toc ol {
		margin: 0;
		padding-left: 1.5em;
	}
	.toc ol li {
		margin-bottom: 0.3em;
	}
	.toc a {
		text-decoration: none;
	}
	.toc a:hover {
		text-decoration: underline;
	}

	/* === Feature Sections === */
	.guide-section {
		padding: 1em 0;
	}
	.guide-section h2 {
		text-align: left;
		margin-bottom: 0.75em;
	}
	.guide-section h2::after {
		margin: 0.3em 0 0 0;
	}
	.subsection {
		margin-bottom: 1.5em;
	}
	.subsection h3 {
		font-size: 1.2rem;
		margin-bottom: 0.5em;
	}

	/* === Steps === */
	.steps {
		padding-left: 1.2em;
		line-height: 2;
	}
	.steps li {
		margin-bottom: 0.5em;
	}

	/* === Screenshot === */
	.screenshot {
		margin: 1em 0;
	}
	.screenshot img {
		width: 100%;
		max-width: 700px;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
		border: 1px solid rgb(var(--gray-light));
	}
	.caption {
		font-size: 0.8rem;
		color: rgb(var(--gray));
		margin-top: 0.5em;
		text-align: center;
	}

	/* === Back to Top === */
	.back-to-top {
		display: inline-block;
		margin-top: 1em;
		font-size: 0.9rem;
		color: var(--accent);
		text-decoration: none;
	}
	.back-to-top:hover {
		text-decoration: underline;
	}

	hr {
		margin: 2em 0;
	}

	@media (max-width: 768px) {
		.guide-section h2 {
			font-size: 1.5rem;
		}
	}
</style>
